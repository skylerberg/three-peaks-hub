# Copied to .env by `pnpm setup:env`. Ports are in this repo's own block --
# Canva's CLI defaults to 8080, which every other project on the laptop also
# takes, and 3001, which this repo's API container is pinned to in production.
CANVA_FRONTEND_PORT=17340
# Where the app sends its requests. The web app's client is same-origin and has
# no base URL to get wrong; this one runs in Canva's iframe, so every call is
# cross-origin and the host has to be named. The API must also list the app's
# origin in CORS_ORIGINS or the browser refuses the response.
CANVA_BACKEND_HOST=http://localhost:17310
# The app in the Developer Portal this checkout builds for. The Canva CLI reads
# it from this file and nowhere else, so `pnpm canva:release` stops without it;
# `canva apps link` writes the line for you, and apps/api/.env already holds the
# same id, because the audience the API pins its tokens to is this app.
# CANVA_APP_ID=
