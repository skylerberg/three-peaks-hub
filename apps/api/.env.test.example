# Copy to .env.test (or run `pnpm setup:env` from the repo root).
#
# DB_DATABASE is a *base* name only. vitest.config.ts appends this checkout's
# directory name and a hash of its path, and asserts the result — so setting it
# to reach a specific database fails loudly rather than working. That is what
# lets parallel worktrees run the suite at once.

ENVIRONMENT=test
DB_HOSTNAME=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=three_peaks_hub_test

STORAGE_DRIVER=disk
STORAGE_DISK_ROOT=./data/test-uploads

# Two test files drive a real Redis and skip without this. Never set REDIS_URL
# here: that would put the whole suite on one shared rate-limit budget and it
# collapses into 429s.
REDIS_TEST_URL=redis://127.0.0.1:6379/15
