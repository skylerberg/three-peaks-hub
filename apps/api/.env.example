# Copy to .env (or run `pnpm setup:env` from the repo root).

PORT=17310
ENVIRONMENT=development

DB_HOSTNAME=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=three_peaks_hub
# Path to a CA certificate. Set for Cloud SQL; leaving it empty disables TLS,
# which is right for a loopback connection and wrong for anything else.
DB_CA_CERT_PATH=
DB_POOL_MAX=10

# `disk` writes under STORAGE_DISK_ROOT; `gcs` needs STORAGE_GCS_BUCKET and
# Application Default Credentials (Workload Identity in the cluster — no key).
STORAGE_DRIVER=disk
STORAGE_DISK_ROOT=./data/uploads
STORAGE_GCS_BUCKET=

# Unset means the realtime bus and rate limiter stay per-process, which is
# correct for a single dev process and wrong for the 2-replica deployment.
REDIS_URL=

# Comma-separated. In dev the SPA is a different origin (17300) from the API
# (17310); in production the load balancer puts them on one origin and this is
# a formality.
CORS_ORIGINS=http://localhost:17300
APP_URL_BASE=http://localhost:17300

# Required in production — the server refuses to boot without it there.
PASSWORD_RESET_SECRET=dev-only-password-reset-secret

# `console` prints the mail instead of sending it. `ses` additionally requires
# SES_FROM_ADDRESS and SES_REGION, and the boot asserts them: every send runs in
# a post-commit hook where a throw is caught and logged, so a misconfigured
# deploy would otherwise look healthy and mail nothing.
EMAIL_DRIVER=console
SES_REGION=
SES_FROM_ADDRESS=

# Whether to believe X-Forwarded-For, and how many hops of it. Parsed strictly:
# these decide which address the rate limiter counts against.
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
